<resources>
    <!-- DayNight Theme (Supports Light and Dark mode switching automatically) -->
    <style name="Theme.RecorderZ" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_lavender</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/bg_main</item>
        <item name="colorSecondary">@color/accent_lavender_dim</item>
        <item name="colorTertiary">@color/text_secondary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurface">@color/bg_main</item>
        <item name="sliderStyle">@style/Widget.Custom.Slider</item>
    </style>

    <style name="Widget.Custom.Slider" parent="Widget.Material3.Slider">
        <item name="labelStyle">@style/Widget.Custom.Tooltip</item>
    </style>

    <style name="Widget.Custom.Tooltip" parent="Widget.Material3.Tooltip">
        <item name="backgroundTint">@color/slider_red</item>
        <item name="android:textColor">@color/bg_main</item>
    </style>
</resources>